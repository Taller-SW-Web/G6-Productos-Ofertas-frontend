{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/g7/api/v1/:path*",
      "destination": "https://g7-auth-service.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://apim-g6-productos-chile.azure-api.net/api/v1/:path*"
    },
    {
      "source": "/((?!assets(?:/|$)|api(?:/|$)|g7(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/((?!assets(?:/|$)|api(?:/|$)|g7(?:/|$)).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/v1/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/g7/api/v1/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  }
}

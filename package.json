{
  "name": "productos-ofertas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit:combos && npm run test:unit:bulk && npm run test:unit:pricing",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test",
    "test:e2e:smoke:bulk": "playwright test tests/bulk.spec.ts",
    "test:ci": "npm run test && npm run test:e2e -- --reporter=line && npm run test:e2e:pricing -- --reporter=line",
    "test:unit:pricing": "vitest run --config src/features/pricing/adapters/vitest.config.ts",
    "test:e2e:pricing": "playwright test --config src/features/pricing/testing/playwright.config.ts",
    "test:unit:bulk": "vitest run --config vitest.bulk.config.ts",
    "test:unit:combos": "vitest run --config vitest.config.ts",
    "test:smoke:combos": "playwright test --config playwright.combos.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@tabler/icons-react": "3.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}

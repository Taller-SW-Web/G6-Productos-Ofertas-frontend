# Development may default to mock; production builds require this explicit setting.
# mock = demonstration. api = real integration; unavailable providers fail visibly.
VITE_DATA_MODE=mock
# Demo interna de lectura real (productos/categorias/precios), sin login.
# Habilitar junto con VITE_DATA_MODE=api solo al aprobar la publicacion.
# Ruta aislada: /demo/g6/productos. Requiere VITE_GATEWAY_ORIGIN y CORS aprobado.
# Vercel no actúa como proxy de /api/v1; no hay destino público implícito.
VITE_G6_READ_DEMO=false
# El panel administrativo API requiere la sesión general G7.
# Catálogo, Taxonomía, Bulk y Promotions reutilizan esa única sesión.
# Sin G7 válido, el acceso privado falla cerrado; la demo de lectura es independiente.
# HTTPS outside loopback. Include the published API base path for G7.
# VITE_GATEWAY_ORIGIN=https://gateway.example.org
# VITE_G7_API_BASE=https://security.example.org/api/v1

# Development may default to mock; production builds require this explicit setting.
# mock = demonstration. api = real integration; unavailable providers fail visibly.
VITE_DATA_MODE=mock
# Demo interna de lectura real (productos/categorias/precios), sin login.
# Habilitar junto con VITE_DATA_MODE=api solo al aprobar la publicacion.
# Ruta aislada: /demo/g6/productos. Requiere VITE_GATEWAY_ORIGIN y CORS aprobado.
# Las consultas públicas usan el origen resuelto por la configuración de Vercel.
VITE_G6_READ_DEMO=false
# El panel administrativo API requiere la sesión general G7.
# Los módulos administrativos reutilizan esa única sesión.
# Sin G7 válido, el acceso privado falla cerrado; la demo de lectura es independiente.
# HTTPS outside loopback. Include the published API base path for G7.
# VITE_GATEWAY_ORIGIN=https://gateway.example.org
# VITE_G7_API_BASE=https://security.example.org/api/v1
# Habilitar solo contra un Gateway con los contratos administrativos de Backend #222.
# Azure y su proxy fijo Vercel requieren verificar primero la release compatible.
VITE_G6_ADMIN_API_ENABLED=false
# Estas capacidades solo aceptan un manifiesto aprobado, con digest y releaseId
# inyectados por el proceso autorizado de release. No rellenar manualmente.
VITE_BULK_HOMOLOGATION_MANIFEST_JSON=
VITE_BULK_AUTHORIZED_RELEASE_ID=
VITE_BULK_AUTHORIZED_MANIFEST_SHA256=
# Conciliación, replay y retry permanecen desactivados mientras no exista ese manifiesto.
VITE_BULK_RECONCILIATION_ENABLED=false
VITE_BULK_REPLAY_ENABLED=false
VITE_BULK_RESUME_ENABLED=false
# Pricing usa los identificadores de canal publicados por el proveedor.
